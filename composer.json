{
  "name": "zainul1996/relay-php-fixture",
  "description": "Minimal PHP project for the Relay live corpus",
  "type": "project",
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.4"
  },
  "autoload": {
    "psr-4": {
      "Relay\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Relay\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  }
}
